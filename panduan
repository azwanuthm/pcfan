            <text x="185" y="32" text-anchor="middle" font-size="13" font-weight="700" fill="#0f172a">Profil Thin Circular-Arc (Hidung NACA)</text>
            <!-- Garisan Kord -->
            <line x1="50" y1="138" x2="315" y2="138" stroke="#94a3b8" stroke-dasharray="5,4" stroke-width="1.5" />
            <!-- Bentuk Aerofoil -->
            <path d="M 52 138 C 52 118, 125 82, 200 88 C 255 92, 295 118, 315 135 L 315 141 C 285 128, 240 110, 185 109 C 125 108, 70 128, 52 138 Z" fill="#bae6fd" stroke="#0284c7" stroke-width="2.2" />
            <!-- Label LE & TE -->
            <circle cx="52" cy="138" r="3.5" fill="#0f172a" />
            <text x="36" y="160" font-size="11" font-weight="700" fill="#0f172a">LE (Bulat)</text>
            <text x="36" y="173" font-size="10" fill="#475569">√x NACA</text>

            <circle cx="315" cy="138" r="3.5" fill="#0f172a" />
